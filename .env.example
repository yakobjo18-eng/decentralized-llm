# Root-level environment overrides, shared conceptually across the Go
# orchestrator and Python workers (each process also reads its own
# .env if present in its own working directory -- see
# orchestrator/orchestrator.example.yaml and worker/worker.example.yaml
# for the YAML-file equivalents of these same settings).
#
# Nothing here is a real machine's IP -- these are local-development
# placeholders. Per Rule 11, no address is ever hardcoded in code.

# --- Orchestrator (Go) ---
ORCHESTRATOR_REST_ADDRESS=0.0.0.0:8080
ORCHESTRATOR_GRPC_ADDRESS=0.0.0.0:9090
ORCHESTRATOR_LOG_LEVEL=info
ORCHESTRATOR_CORS_ORIGIN=http://localhost:3000
ORCHESTRATOR_HEARTBEAT_TIMEOUT_SECONDS=15
# Phase 3: accept SIMULATED hardware profiles (development only).
ORCHESTRATOR_ALLOW_SIMULATED_WORKERS=false

# --- Worker (Python) ---
# Set WORKER_ORCHESTRATOR_ADDRESS to Computer 1's real LAN IP when
# running a worker on Computer 2 or Computer 3, e.g. 192.168.1.10:9090.
WORKER_ID=
WORKER_ORCHESTRATOR_ADDRESS=127.0.0.1:9090
WORKER_LISTEN_HOST=0.0.0.0
WORKER_LISTEN_PORT=50100
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_LOG_LEVEL=info
# Phase 3. WORKER_ADVERTISE_HOST: this worker's LAN IP, if its hostname
# doesn't resolve from Computer 1. WORKER_SIMULATED_PROFILE: leave empty
# for real hardware (see docs/SIMULATED_HARDWARE.md).
WORKER_ADVERTISE_HOST=
WORKER_HARDWARE_REFRESH_INTERVAL_SECONDS=300
WORKER_GPU_METRICS_INTERVAL_SECONDS=15
WORKER_BACKEND_COMPUTE_TEST=true
WORKER_SIMULATED_PROFILE=
